# URL do seu projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave "service_role" (Project Settings -> API -> service_role secret)
# ATENÇÃO: essa chave tem acesso total ao banco. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=coloque-sua-chave-service-role-aqui

# Segredo usado para assinar/validar o token de login (JWT) do sistema.
# Gere uma string aleatória longa, por exemplo rodando no terminal:
#   openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-e-longa

# Porta em que a API vai rodar
PORT=3001

# Origem permitida para CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173

# Access token do Mercado Pago (opcional - só necessário se for usar o gateway)
# Obtenha em https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=coloque-seu-access-token-aqui

# Asaas (recomendado para academia: boleto, PIX e cartão de verdade, com
# notificação automática de cobrança). Se preenchido, o Asaas tem prioridade
# sobre o Mercado Pago. Pegue a chave em asaas.com -> Integrações -> API Key.
# Use a chave de Sandbox pra testar antes de ir pra produção.
ASAAS_API_KEY=coloque-sua-chave-do-asaas-aqui
ASAAS_ENV=sandbox
# Token que você escolhe ao criar o Webhook no painel do Asaas (Integrações
# -> Webhooks). O Asaas devolve esse mesmo valor no header em cada chamada,
# provando que a notificação é legítima.
ASAAS_WEBHOOK_TOKEN=escolha-um-token-aleatorio-e-configure-igual-no-asaas
