# URL do seu projeto Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave "service_role" (Project Settings -> API -> service_role secret)
# ATENÇÃO: essa chave tem acesso total ao banco. NUNCA exponha no frontend.
SUPABASE_SERVICE_ROLE_KEY=coloque-sua-chave-service-role-aqui

# Segredo usado para assinar/validar o token de login (JWT) do sistema.
# Gere uma string aleatória longa, por exemplo rodando no terminal:
#   openssl rand -hex 32
JWT_SECRET=troque-por-uma-string-aleatoria-e-longa

# Porta em que a API vai rodar
PORT=3001

# Origem permitida para CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173

# OBRIGATÓRIA a partir da migração 006 (gateway de pagamento por academia):
# chave usada para criptografar as credenciais do Asaas/Mercado Pago de cada
# academia antes de salvar no banco. Gere uma string aleatória longa:
#   openssl rand -hex 32
# Se você trocar essa chave depois de já ter academias com gateway
# configurado, as credenciais salvas ficam ilegíveis - elas teriam que
# configurar de novo pela tela.
GATEWAY_ENCRYPTION_KEY=troque-por-uma-string-aleatoria-e-longa

# --- Gateway de pagamento: valores PADRÃO (fallback) ---
# A partir de agora, cada academia configura sua PRÓPRIA conta na tela
# Configurações > Gateway de Pagamento (dentro do sistema, não aqui no
# .env) - assim o dinheiro de cada academia cai na conta certa dela.
# Os dois valores abaixo são opcionais: só servem de "conta padrão" pra
# quem ainda não configurou nada na tela (ex: se você já usava o sistema
# assim antes desta versão, continua funcionando sem precisar mudar nada
# até decidir migrar pra tela nova).
MERCADOPAGO_ACCESS_TOKEN=
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# NÃO é mais usada: antes, esse token validava o webhook do Asaas. Agora
# cada notificação é reconfirmada direto na API do Asaas (com a chave da
# academia correspondente) antes de dar baixa, o que é mais seguro e
# funciona por academia. Pode remover essa variável com segurança.
# ASAAS_WEBHOOK_TOKEN=
