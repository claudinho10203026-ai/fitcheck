# URL da API do seu sistema (sem barra no final). Em produção, é a URL do
# seu backend publicado; em teste local, algo como http://localhost:3001/api
API_URL=http://localhost:3001/api

# Chave de integração gerada na tela Controle de Acesso > Configurar catraca
CHAVE_INTEGRACAO=cole_aqui_a_chave_gerada_no_sistema

# Nome que vai aparecer no histórico de acessos identificando esta catraca
NOME_DISPOSITIVO=Catraca Entrada Principal
